  --pink-text-on-pink: oklch(100% 0 0);
  
  /* Light Mode - Semantic */
  --success: oklch(58% 0.14 145);
  --success-bg: oklch(94% 0.05 145);
  --danger: oklch(60% 0.20 25);
  --danger-bg: oklch(95% 0.06 25);
  --warning: oklch(70% 0.14 85);
  --warning-bg: oklch(93% 0.08 85);
  --info: oklch(62% 0.14 245);
